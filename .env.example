NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster.mongodb.net/picky

# Redis (local: redis://localhost:6379 | Upstash: rediss://...)
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# WATI (WhatsApp Official API & Team Inbox)
WATI_API_ENDPOINT=https://your-wati-endpoint.wati.io
WATI_ACCESS_TOKEN=your_wati_bearer_access_token

# AWS S3 (Product & Category Images)
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-s3-bucket-name
AWS_CLOUDFRONT_URL=https://your-distribution.cloudfront.net

# OTP Settings
OTP_EXPIRE_SECONDS=300
OTP_MAX_ATTEMPTS=3

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Razorpay (UPI, Cards, NetBanking)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
# Webhook secret — copy from Razorpay Dashboard → Webhooks → your webhook → Secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
